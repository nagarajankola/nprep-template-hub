# ───────── Admin login (the gallery password gate) ─────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD="Qwerty123#"

# ───────── Session signing secret ─────────
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# ───────── Supabase ─────────
# Leave BOTH blank to use the local JSON store (great for dev).
# Fill them in to go live. Project Settings → API.
# Use the SECRET service_role key — never the public anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Auto-register ingest key ─────────
# Secret for POST /api/ingest (the global pusher). Generate: openssl rand -hex 24
HUB_INGEST_KEY=

# ───────── Public base URL (used to build share links) ─────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
